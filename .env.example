# Kopiera till .env.local för lokal körning (lägg in samma värden i Vercel → Settings → Environment Variables)
ANTHROPIC_API_KEY=sk-ant-...
# Ditt personliga lösenord/token som appen skickar med varje anrop
APP_TOKEN=byt-till-en-lang-slumpad-strang
# Apps Script-webbappens URL (slutar på /exec) och den hemlighet du satt i skriptet
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXX/exec
APPS_SCRIPT_SECRET=byt-till-en-annan-lang-slumpad-strang
# Google Cloud Vision (bildsök). Utan den hoppas bildsöket över.
GOOGLE_VISION_API_KEY=AIza...
# Valfritt: standardmodeller per steg (kan också väljas i appen)
# ID_MODEL=claude-opus-5-5
# SEARCH_MODEL=claude-haiku-5-5
# MAX_SEARCHES=4
